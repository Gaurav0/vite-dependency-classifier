{
  "name": "vite-dependency-classifier",
  "version": "0.1.0",
  "description": "Check that a Vite project's dependencies/devDependencies split matches what the production build actually contains.",
  "author": "Gaurav Munjal <Gaurav0@aol.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaurav0/vite-dependency-classifier.git"
  },
  "bugs": {
    "url": "https://github.com/Gaurav0/vite-dependency-classifier/issues"
  },
  "homepage": "https://github.com/Gaurav0/vite-dependency-classifier#readme",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "index.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "vite-dependency-classifier": "./dist/check.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node src/check.ts"
  },
  "engines": {
    "node": "^22.18.0 || ^24.3.0 || >=26.0.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^22.18.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fixture-leaf": "file:test/fixtures/packages/fixture-leaf",
    "fixture-lib": "file:test/fixtures/packages/fixture-lib",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
